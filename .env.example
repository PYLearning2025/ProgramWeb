# ===========================================================================
# ProgramWeb 環境變數範本
# ---------------------------------------------------------------------------
# 用法：複製本檔為 .env，填入實際值。.env 已列入 .gitignore，切勿提交。
#   cp .env.example .env
# Azure 部署時，這些變數請改設於
#   App Service → 設定 → 環境變數 (Application settings)，不要上傳 .env。
# ===========================================================================

# --- Django 核心 ---------------------------------------------------------
# 產生方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=請填入隨機密鑰

# 本機開發設 True；正式環境（Azure）務必設 False
DEBUG=True

# 逗號分隔。本機可留 localhost,127.0.0.1；Azure 需加上 *.azurewebsites.net 網域
# 註：目前 settings.py 為硬編碼，尚未讀取此變數，詳見 LOCAL_DEVELOPMENT.md
ALLOWED_HOSTS=localhost,127.0.0.1

# 逗號分隔，需含 https:// 前綴；Azure 網域示例如下
CSRF_TRUSTED_ORIGINS=https://programwebdevelop.azurewebsites.net

# --- PostgreSQL 資料庫 ---------------------------------------------------
DATABASE_NAME=programweb
DATABASE_USER=postgres
DATABASE_PASSWORD=請填入資料庫密碼
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- AI 服務金鑰 ----------------------------------------------------------
# Gemini：題目難度分析（ai/views.py 透過 langchain-google-genai 使用）
GEMINI_API_KEY=請填入_Gemini_API_金鑰
# OpenAI：保留用
OPENAI_API_KEY=請填入_OpenAI_API_金鑰
